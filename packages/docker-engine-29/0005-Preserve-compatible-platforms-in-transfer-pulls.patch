Subject: [PATCH] Preserve compatible platforms in transfer pulls

The transfer store uses an ordered list of exact platform matches. Sending
only the CPU-specific host platform skips baseline amd64 manifests on v4
hosts, causing the complete-content check to reject normal ECS image pulls.
Expose the vendored platforms package's existing compatibility vector and
use it for both download selection and unpack configuration. Limit the
selected manifests to one, matching Docker's platform preference behavior.

Exercise the transfer store's actual image filter for fallback, preference,
unsupported platforms and unpack configuration in the package regressions.
---

diff --git a/daemon/containerd/image_pull.go b/daemon/containerd/image_pull.go
--- a/daemon/containerd/image_pull.go
+++ b/daemon/containerd/image_pull.go
@@ -141,13 +141,8 @@
 	if err != nil {
 		return err
 	}
-	storeOpts := []transferimage.StoreOpt{
-		transferimage.WithPlatforms(pullPlatform),
-	}
 	lazy := i.lazyPull(i.snapshotter)
-	if lazy {
-		storeOpts = append(storeOpts, transferimage.WithUnpack(pullPlatform, i.snapshotter))
-	}
+	storeOpts := transferPullStoreOptions(pullPlatform, i.snapshotter, lazy)
 	if err := i.client.Transfer(ctx, reg, transferimage.NewStore(ref.String(), storeOpts...)); err != nil {
 		return translateTransferPullError(ctx, ref, pullPlatform, err)
 	}
@@ -176,7 +171,7 @@
 		if err != nil {
 			return err
 		}
-		storeOpts = append(storeOpts, transferimage.WithUnpack(pullPlatform, i.snapshotter))
+		storeOpts = transferPullStoreOptions(pullPlatform, i.snapshotter, true)
 		if err := i.client.Transfer(ctx, reg, transferimage.NewStore(ref.String(), storeOpts...)); err != nil {
 			return translateTransferPullError(ctx, ref, pullPlatform, err)
 		}
diff --git a/daemon/containerd/image_pull_transfer.go b/daemon/containerd/image_pull_transfer.go
--- a/daemon/containerd/image_pull_transfer.go
+++ b/daemon/containerd/image_pull_transfer.go
@@ -6,6 +6,7 @@
 	"strings"
 
 	"github.com/containerd/containerd/v2/core/remotes/docker"
+	transferimage "github.com/containerd/containerd/v2/core/transfer/image"
 	transferregistry "github.com/containerd/containerd/v2/core/transfer/registry"
 	cerrdefs "github.com/containerd/errdefs"
 	"github.com/containerd/platforms"
@@ -16,6 +17,23 @@
 	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
 	"github.com/pkg/errors"
 )
+
+// The transfer protocol carries an ordered list of exact platforms, not a
+// MatchComparer. Expand Only's compatibility set so an amd64/v4 host can pull
+// a baseline amd64 image, while still preferring the best matching manifest.
+func transferPullStoreOptions(platform ocispec.Platform, snapshotter string, unpack bool) []transferimage.StoreOpt {
+	compatible := platforms.CompatiblePlatforms(platform)
+	opts := []transferimage.StoreOpt{
+		transferimage.WithPlatforms(compatible...),
+		transferimage.WithManifestLimit(1),
+	}
+	if unpack {
+		for _, p := range compatible {
+			opts = append(opts, transferimage.WithUnpack(p, snapshotter))
+		}
+	}
+	return opts
+}
 
