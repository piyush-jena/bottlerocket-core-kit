--- /dev/null
+++ b/vendor/github.com/containerd/platforms/compatible.go
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: Apache-2.0
+
+package platforms
+
+import specs "github.com/opencontainers/image-spec/specs-go/v1"
+
+// CompatiblePlatforms exposes the same ordered compatibility set as Only for
+// protocols, such as containerd transfer, that require explicit platform lists.
+func CompatiblePlatforms(platform specs.Platform) []specs.Platform {
+	return platformVector(Normalize(platform))
+}
