+// ImageFilter writes GC labels, which do not affect platform selection.
+type platformSelectionStore struct {
+	content.Store
+}
+
+func (platformSelectionStore) Update(_ context.Context, info content.Info, _ ...string) (content.Info, error) {
+	return info, nil
+}
+
+func TestTransferPlatformSelection(t *testing.T) {
+	tests := []struct {
+		name      string
+		requested string
+		available []string
+		want      string
+	}{
+		{"amd64 v4 accepts baseline", "linux/amd64/v4", []string{"linux/arm64", "linux/amd64"}, "linux/amd64"},
+		{"prefer best compatible amd64", "linux/amd64/v4", []string{"linux/amd64", "linux/amd64/v3", "linux/amd64/v2"}, "linux/amd64/v3"},
+		{"reject newer amd64", "linux/amd64/v2", []string{"linux/amd64/v4", "linux/amd64"}, "linux/amd64"},
+		{"retain 386 compatibility", "linux/amd64", []string{"linux/386"}, "linux/386"},
+		{"arm64 compatibility", "linux/arm64/v9", []string{"linux/arm64/v8", "linux/arm/v7"}, "linux/arm64/v8"},
+		{"arm compatibility", "linux/arm/v7", []string{"linux/arm/v6", "linux/arm/v5"}, "linux/arm/v6"},
+		{"reject unrelated architecture", "linux/amd64/v4", []string{"linux/arm64"}, ""},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			requested := platforms.MustParse(tt.requested)
+			children := make([]ocispec.Descriptor, 0, len(tt.available))
+			for _, text := range tt.available {
+				p := platforms.MustParse(text)
+				children = append(children, ocispec.Descriptor{MediaType: ocispec.MediaTypeImageManifest, Digest: digest.FromString(text), Platform: &p})
+			}
+			for _, unpack := range []bool{false, true} {
+				store := transferimage.NewStore("example.com/test:latest", transferPullStoreOptions(requested, "overlayfs", unpack)...)
+				filter := store.ImageFilter(func(context.Context, ocispec.Descriptor) ([]ocispec.Descriptor, error) {
+					return children, nil
+				}, platformSelectionStore{})
+				selected, err := filter(context.Background(), ocispec.Descriptor{MediaType: ocispec.MediaTypeImageIndex, Digest: digest.FromString("index")})
+				if tt.want == "" {
+					if !cerrdefs.IsNotFound(err) {
+						t.Fatalf("unpack=%v: wanted not-found, got %v (%v)", unpack, err, selected)
+					}
+					continue
+				}
+				if err != nil {
+					t.Fatalf("unpack=%v: %v", unpack, err)
+				}
+				if len(selected) != 1 || !platforms.OnlyStrict(platforms.MustParse(tt.want)).Match(*selected[0].Platform) {
+					t.Fatalf("unpack=%v: selected %v, want only %s", unpack, selected, tt.want)
+				}
+				matchedUnpack := false
+				for _, config := range store.UnpackPlatforms() {
+					if config.Snapshotter != "overlayfs" {
+						t.Fatalf("wrong snapshotter: %q", config.Snapshotter)
+					}
+					matchedUnpack = matchedUnpack || platforms.OnlyStrict(config.Platform).Match(*selected[0].Platform)
+				}
+				if unpack != matchedUnpack {
+					t.Fatalf("unpack=%v: selected platform has unpack configuration=%v", unpack, matchedUnpack)
+				}
+			}
+		})
+	}
+}
 
