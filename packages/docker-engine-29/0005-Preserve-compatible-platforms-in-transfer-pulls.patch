 		}
-		storeOpts = append(storeOpts, transferimage.WithUnpack(pullPlatform, i.snapshotter))
+		storeOpts = transferPullStoreOptions(pullPlatform, i.snapshotter, true)
 		if err := i.client.Transfer(ctx, reg, transferimage.NewStore(ref.String(), storeOpts...)); err != nil {
 			return translateTransferPullError(ctx, ref, pullPlatform, err)
 		}
