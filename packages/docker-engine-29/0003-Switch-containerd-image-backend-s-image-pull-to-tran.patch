+// pullTag uses containerd's transfer service so registry configuration in
+// hosts.toml and remote snapshotters work with the image backend.
 func (i *ImageService) pullTag(ctx context.Context, ref reference.Named, platform *ocispec.Platform, metaHeaders map[string][]string, authConfig *registrytypes.AuthConfig, out progress.Output) error {
+	// The transfer resolver only consumes username/secret credentials, even
+	// though its wire format can carry a bearer header. Keep the upstream
+	// resolver for pre-issued registry tokens instead of discarding them.
+	if authConfig != nil && authConfig.RegistryToken != "" {
+		return i.pullTagLocal(ctx, ref, platform, metaHeaders, authConfig, out)
+	}
+
+	pullPlatform := i.hostPlatformSpec()
+	if platform != nil {
+		pullPlatform = *platform
+	}
+
+	oldImage, err := i.resolveImage(ctx, ref.String())
+	if err != nil && !cerrdefs.IsNotFound(err) {
+		return err
+	}
+	var newImage *c8dimages.Image
+	if oldImage.Target.Digest != "" {
+		if err := i.leaseContent(ctx, i.content, oldImage.Target); err != nil {
+			return errdefs.System(fmt.Errorf("failed to lease content: %w", err))
+		}
+		defer func() {
+			if newImage != nil && newImage.Target.Digest != oldImage.Target.Digest {
+				if err := i.ensureDanglingImage(ctx, oldImage); err != nil {
+					log.G(ctx).WithError(err).Warn("failed to keep the previous image as dangling")
+				}
+			}
+		}()
+	}
+
+	registryOpts := []transferregistry.Opt{
+		transferregistry.WithHeaders(metaHeaders),
+		transferregistry.WithCredentials(authConfigCreds{authConfig}),
+		transferregistry.WithHostDir(dockerregistry.CertsDir()),
+	}
+	reg, err := transferregistry.NewOCIRegistry(ctx, ref.String(), registryOpts...)
+	if err != nil {
+		return err
+	}
+	storeOpts := []transferimage.StoreOpt{
+		transferimage.WithPlatforms(pullPlatform),
+	}
+	lazy := i.lazyPull(i.snapshotter)
+	if lazy {
+		storeOpts = append(storeOpts, transferimage.WithUnpack(pullPlatform, i.snapshotter))
+	}
+	if err := i.client.Transfer(ctx, reg, transferimage.NewStore(ref.String(), storeOpts...)); err != nil {
+		return translateTransferPullError(ctx, ref, pullPlatform, err)
+	}
+	metadata, err := i.images.Get(ctx, ref.String())
+	if err != nil {
+		return fmt.Errorf("read transferred image: %w", err)
+	}
+
+	if !lazy {
+		// containerd 2.2's transfer unpacker can skip layer downloads when
+		// snapshots exist. Fetch without unpack first to retain 29.9's
+		// complete-content guarantee for save/push, then unpack by digest
+		// so a moving registry tag cannot change the content between passes.
+		available, _, _, missing, err := c8dimages.Check(ctx, i.content, metadata.Target, platforms.Only(pullPlatform))
+		if err != nil {
+			return err
+		}
+		if !available || len(missing) != 0 {
+			return errdefs.System(fmt.Errorf("transferred image %s has incomplete content for %s", ref, platforms.FormatAll(pullPlatform)))
+		}
+		pinned, err := reference.WithDigest(reference.TrimNamed(ref), metadata.Target.Digest)
+		if err != nil {
+			return err
+		}
+		reg, err = transferregistry.NewOCIRegistry(ctx, pinned.String(), registryOpts...)
+		if err != nil {
+			return err
+		}
+		storeOpts = append(storeOpts, transferimage.WithUnpack(pullPlatform, i.snapshotter))
+		if err := i.client.Transfer(ctx, reg, transferimage.NewStore(ref.String(), storeOpts...)); err != nil {
+			return translateTransferPullError(ctx, ref, pullPlatform, err)
+		}
+	}
+
+	img := containerd.NewImageWithPlatform(i.client, metadata, platforms.Only(pullPlatform))
+	unpacked, err := img.IsUnpacked(ctx, i.snapshotter)
+	if err != nil {
+		return err
+	}
+	if !unpacked {
+		return errdefs.System(fmt.Errorf("transferred image %s was not unpacked with snapshotter %s", ref, i.snapshotter))
+	}
+	newImage = &metadata
+	if err := i.images.Delete(context.WithoutCancel(ctx), danglingImageName(metadata.Target.Digest)); err != nil && !cerrdefs.IsNotFound(err) {
+		log.G(ctx).WithError(err).Warn("unexpected error while removing outdated dangling image reference")
+	}
+	progress.Message(out, "", "Digest: "+metadata.Target.Digest.String())
+	writeStatus(out, reference.FamiliarString(ref), oldImage.Target.Digest != metadata.Target.Digest)
+	i.LogImageEvent(ctx, reference.FamiliarString(ref), reference.FamiliarName(ref), events.ActionPull)
+	i.warmImageIdentityCache(ctx, metadata)
+	log.G(ctx).WithField("image", reference.FamiliarString(ref)).Info("image pull complete")
+	return nil
+}
+
+func (i *ImageService) pullTagLocal(ctx context.Context, ref reference.Named, platform *ocispec.Platform, metaHeaders map[string][]string, authConfig *registrytypes.AuthConfig, out progress.Output) error {
 	// Register media types used by Sigstore bundles and OCI referrers so that
 	// MakeRefKey can assign a proper ref-key prefix instead of logging
 	// "reference for unknown type" warnings.
