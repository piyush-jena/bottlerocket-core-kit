new file mode 100644
index 0000000..f7c958f
--- /dev/null
+++ b/daemon/containerd/image_pull_transfer.go
@@ -0,0 +1,62 @@
+package containerd
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"github.com/containerd/containerd/v2/core/remotes/docker"
+	transferregistry "github.com/containerd/containerd/v2/core/transfer/registry"
+	cerrdefs "github.com/containerd/errdefs"
+	"github.com/containerd/platforms"
+	"github.com/distribution/reference"
+	registrytypes "github.com/moby/moby/api/types/registry"
+	dockerregistry "github.com/moby/moby/v2/daemon/pkg/registry"
+	"github.com/moby/moby/v2/errdefs"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+	"github.com/pkg/errors"
+)
+
+func translateTransferPullError(ctx context.Context, ref reference.Named, platform ocispec.Platform, err error) error {
+	if errors.Is(err, docker.ErrInvalidAuthorization) {
+		if strings.Contains(err.Error(), "no basic auth credentials") {
+			return err
+		}
+		return errdefs.NotFound(fmt.Errorf("pull access denied for %s, repository does not exist or may require 'docker login'", reference.FamiliarName(ref)))
+	}
+	if cerrdefs.IsNotFound(err) && strings.Contains(err.Error(), "platform") {
+		return errdefs.NotFound(fmt.Errorf("no matching manifest for %s in the manifest list entries: %w", platforms.FormatAll(platform), err))
+	}
+	return translateRegistryError(ctx, err)
+}
+
+type authConfigCreds struct {
+	*registrytypes.AuthConfig
+}
+
+func (c authConfigCreds) GetCredentials(_ context.Context, refString, host string) (transferregistry.Credentials, error) {
+	if c.AuthConfig == nil {
+		return transferregistry.Credentials{}, nil
+	}
+	normalizeHost := func(host string) string {
+		if host == dockerregistry.IndexName || host == dockerregistry.IndexHostname {
+			return dockerregistry.DefaultRegistryHost
+		}
+		return host
+	}
+	cfgHost := dockerregistry.ConvertToHostname(c.ServerAddress)
+	if cfgHost == "" {
+		ref, err := reference.ParseNormalizedNamed(refString)
+		if err != nil {
+			return transferregistry.Credentials{}, err
+		}
+		cfgHost = reference.Domain(ref)
+	}
+	if normalizeHost(host) != normalizeHost(cfgHost) {
+		return transferregistry.Credentials{}, nil
+	}
+	if c.IdentityToken != "" {
+		return transferregistry.Credentials{Host: host, Secret: c.IdentityToken}, nil
+	}
+	return transferregistry.Credentials{Host: host, Username: c.Username, Secret: c.Password}, nil
+}
diff --git a/daemon/containerd/image_pull_transfer_test.go b/daemon/containerd/image_pull_transfer_test.go
