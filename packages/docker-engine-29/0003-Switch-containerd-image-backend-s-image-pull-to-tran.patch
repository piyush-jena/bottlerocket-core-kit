+package containerd
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/containerd/containerd/v2/core/remotes/docker"
+	transferregistry "github.com/containerd/containerd/v2/core/transfer/registry"
+	cerrdefs "github.com/containerd/errdefs"
+	"github.com/distribution/reference"
+	registrytypes "github.com/moby/moby/api/types/registry"
+	ocispec "github.com/opencontainers/image-spec/specs-go/v1"
+)
+
+func TestTransferCredentials(t *testing.T) {
+	tests := []struct {
+		name string
+		auth *registrytypes.AuthConfig
+		ref  string
+		host string
+		want transferregistry.Credentials
+	}{
+		{
+			name: "anonymous nil config",
+			ref:  "registry.example/image:latest",
+			host: "registry.example",
+		},
+		{
+			name: "infer server from reference",
+			auth: &registrytypes.AuthConfig{Username: "user", Password: "password"},
+			ref:  "registry.example/image:latest",
+			host: "registry.example",
+			want: transferregistry.Credentials{Host: "registry.example", Username: "user", Secret: "password"},
+		},
+		{
+			name: "Docker Hub index URL",
+			auth: &registrytypes.AuthConfig{ServerAddress: "https://index.docker.io/v1/", Username: "user", Password: "password"},
+			ref:  "docker.io/library/image:latest",
+			host: "registry-1.docker.io",
+			want: transferregistry.Credentials{Host: "registry-1.docker.io", Username: "user", Secret: "password"},
+		},
+		{
+			name: "Docker Hub inferred domain",
+			auth: &registrytypes.AuthConfig{Username: "user", Password: "password"},
+			ref:  "image:latest",
+			host: "registry-1.docker.io",
+			want: transferregistry.Credentials{Host: "registry-1.docker.io", Username: "user", Secret: "password"},
+		},
+		{
+			name: "identity token takes precedence",
+			auth: &registrytypes.AuthConfig{IdentityToken: "refresh", Username: "user", Password: "password"},
+			ref:  "registry.example/image:latest",
+			host: "registry.example",
+			want: transferregistry.Credentials{Host: "registry.example", Secret: "refresh"},
+		},
+		{
+			name: "mirror does not receive origin credentials",
+			auth: &registrytypes.AuthConfig{Username: "user", Password: "password"},
+			ref:  "registry.example/image:latest",
+			host: "mirror.example",
+		},
+		{
+			name: "explicit unrelated server does not receive credentials",
+			auth: &registrytypes.AuthConfig{ServerAddress: "other.example", IdentityToken: "refresh"},
+			ref:  "registry.example/image:latest",
+			host: "registry.example",
+		},
+		{
+			name: "registry port preserved",
+			auth: &registrytypes.AuthConfig{ServerAddress: "https://registry.example:5000/v2/", Username: "user", Password: "password"},
+			ref:  "registry.example:5000/image:latest",
+			host: "registry.example:5000",
+			want: transferregistry.Credentials{Host: "registry.example:5000", Username: "user", Secret: "password"},
+		},
+		{
+			name: "other port does not receive credentials",
+			auth: &registrytypes.AuthConfig{Username: "user", Password: "password"},
+			ref:  "registry.example:5000/image:latest",
+			host: "registry.example:5001",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := (authConfigCreds{tt.auth}).GetCredentials(context.Background(), tt.ref, tt.host)
+			if err != nil || got != tt.want {
+				t.Fatalf("unexpected credentials result: error=%v, matches=%v", err, got == tt.want)
+			}
+		})
+	}
+	t.Run("malformed reference returns an error", func(t *testing.T) {
+		_, err := (authConfigCreds{&registrytypes.AuthConfig{Username: "user"}}).GetCredentials(context.Background(), "invalid reference", "registry.example")
+		if err == nil {
+			t.Fatal("expected invalid reference to fail")
+		}
+	})
+}
+
+func TestTransferPullErrors(t *testing.T) {
+	ref, err := reference.ParseNormalizedNamed("registry.example/image:latest")
+	if err != nil {
+		t.Fatal(err)
+	}
+	platform := ocispec.Platform{OS: "linux", Architecture: "arm64"}
+	ctx := context.Background()
+	t.Run("authorization", func(t *testing.T) {
+		got := translateTransferPullError(ctx, ref, platform, docker.ErrInvalidAuthorization)
+		if !cerrdefs.IsNotFound(got) || !strings.Contains(got.Error(), "pull access denied") {
+			t.Fatalf("unexpected authorization error: %v", got)
+		}
+	})
+	t.Run("missing credentials", func(t *testing.T) {
+		want := fmt.Errorf("no basic auth credentials: %w", docker.ErrInvalidAuthorization)
+		if got := translateTransferPullError(ctx, ref, platform, want); got != want {
+			t.Fatalf("missing credentials error was replaced: %v", got)
+		}
+	})
+	t.Run("platform", func(t *testing.T) {
+		got := translateTransferPullError(ctx, ref, platform, fmt.Errorf("no match for platform: %w", cerrdefs.ErrNotFound))
+		if !cerrdefs.IsNotFound(got) || !strings.Contains(got.Error(), "linux/arm64") {
+			t.Fatalf("unexpected platform error: %v", got)
+		}
+	})
+	t.Run("canceled", func(t *testing.T) {
+		if got := translateTransferPullError(ctx, ref, platform, context.Canceled); !errors.Is(got, context.Canceled) {
+			t.Fatalf("cancellation lost: %v", got)
+		}
+	})
+	t.Run("registry denial", func(t *testing.T) {
+		got := translateTransferPullError(ctx, ref, platform, docker.Error{Code: docker.ErrorCodeDenied, Message: "denied"})
+		if !cerrdefs.IsPermissionDenied(got) {
+			t.Fatalf("registry denial lost: %v", got)
+		}
+	})
+}
