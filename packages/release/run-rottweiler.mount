[Unit]
Description=Ephemeral keystore directory
DefaultDependencies=no
Conflicts=umount.target
After=selinux-policy-files.service
Wants=selinux-policy-files.service
# /run/rottweiler serves as a temporary keystore for all the block-device and directory encryption
Before=encrypt-unlock-datastore.service encrypt-unlock-private-fs.service encrypt-unlock-local-fs.service

[Mount]
What=tmpfs
Where=/run/rottweiler
Type=tmpfs
# noswap to ensure the ephemeral keys are not moved into persistent storage
Options=nosuid,nodev,noexec,noatime,noswap,context=system_u:object_r:private_t:s0,mode=0700

[Install]
RequiredBy=local-fs.target
