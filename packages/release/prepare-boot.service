[Unit]
Description=Prepare Boot Directory (/boot)
RefuseManualStart=true
RefuseManualStop=true
DefaultDependencies=no

[Service]
Type=oneshot
EnvironmentFile=-/usr/share/bottlerocket/image-format.env
# Skip on UKI images, which have no A/B partition sets for the helper to inspect.
# The file may be absent on images built by an older twoliter; the empty expansion
# passes this check so the service runs as it did before.
ExecCondition=[ "${UKI_IMAGE}" != "true" ]
# We need a helper program to mount the boot partition since it isn't
# trivial to figure out which partition set is active
ExecStart=/usr/bin/prairiedog prepare-boot
RemainAfterExit=true
StandardOutput=tty
StandardError=inherit

[Install]
WantedBy=preconfigured.target
